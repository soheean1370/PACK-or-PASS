{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "./scripts/dist",
    "rootDir": "."
  },
  "include": ["./scripts/**/*", "./lib/**/*"]
}
